{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AxiA 3D",
  "version": "0.1.0",
  "identifier": "com.axia3d.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix web run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm --prefix web run build:desktop",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "AxiA 3D",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "copyright": "AxiA 3D",
    "category": "DeveloperTool",
    "shortDescription": "AxiA 3D",
    "longDescription": "AxiA 3D - a modelling engine that runs its kernel locally as WebAssembly."
  }
}
